# EQUILUX — Umgebungsvariablen (nur serverseitig, nie im Client)

# ── Kursdaten ───────────────────────────────────────────────────────────────
# Einzige Datenquelle. EODHD deckt US, Xetra, London, Euronext, Krypto, Forex
# und Indizes ab und liefert auch die Fundamentaldaten für die Bewertung.
# Schlüssel: eodhd.com  → ohne ihn zeigen die Charts nur Demo-Daten.
#
# Hinweis zu den Kerzengrößen: Tages-, Wochen- und Monatskerzen sind im
# EOD-Paket enthalten. Die Intraday-Stufen (1 Min / 5 Min / 1 Std) brauchen bei
# EODHD zusätzlich "Intraday Historical Data" — ohne das Paket antwortet die
# API dort mit 403. Am Code ändert sich dadurch nichts, derselbe Schlüssel gilt.
EODHD_API_KEY=dein_key

# ── Übrige Kerne ────────────────────────────────────────────────────────────
# Für den Marktbrief-Kern (Anthropic-API mit Websuche). Ohne Schlüssel
# funktioniert alles außer dem Marktbrief.
ANTHROPIC_API_KEY=sk-ant-...

# SEC EDGAR verlangt einen User-Agent mit Kontaktadresse (Filings-Kern).
SEC_USER_AGENT="EQUILUX research (mail@example.de)"

# Optional: Datenquelle für Hebelprodukt-Konditionen (WKN/ISIN → Basispreis,
# Laufzeit, Bezugsverhältnis). Vorlage mit Platzhalter {id}.
# DERIV_DATA_URL="https://dein-feed.example/instrument/{id}?token=..."
