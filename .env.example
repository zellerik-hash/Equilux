# EQUILUX — Umgebungsvariablen (nur serverseitig, nie im Client)

# ── Kursdaten ───────────────────────────────────────────────────────────────
# Einzige Datenquelle. EODHD deckt US, Xetra, London, Euronext, Krypto, Forex
# und Indizes ab und liefert auch die Fundamentaldaten für die Bewertung.
# Schlüssel: eodhd.com  → ohne ihn zeigen die Charts nur Demo-Daten.
#
# Zuständig für Tages-, Wochen- und Monatskerzen sowie die Fundamentaldaten.
# Sind die Fundamentaldaten im Tarif nicht enthalten, holt EQUILUX die
# Anteilseigner ersatzweise aus den SEC-Beteiligungsmeldungen (kostenlos,
# aber nur US-Werte und nur Positionen über 5 %) — dafür braucht es
# SEC_USER_AGENT weiter unten.
EODHD_API_KEY=dein_key

# Intraday-Kerzen (1 Min / 5 Min / 1 Std). Kostenloser Schlüssel bei
# twelvedata.com (rund 800 Abrufe/Tag), deckt auch Xetra ab. Nötig, weil
# Intraday bei EODHD ein kostenpflichtiges Zusatzpaket ist — hast du das dort
# gebucht, springt EODHD automatisch als Rückfall ein und dieser Schlüssel
# kann entfallen.
TWELVEDATA_API_KEY=dein_key

# Kostenlos und ohne Zahlungsdaten (alphavantage.co/support/#api-key).
# Liefert Kursziele und Analystenurteile sowie — falls die EODHD-
# Fundamentaldaten nicht im Tarif sind — EPS, Buchwert, Dividende und Beta.
# Harte Grenze im freien Tarif: rund 25 Abrufe am Tag, deshalb hält EQUILUX
# jede Antwort zwölf Stunden im Zwischenspeicher. Nur US-Kürzel.
ALPHAVANTAGE_API_KEY=dein_key

# ── Übrige Kerne ────────────────────────────────────────────────────────────
# Für den Marktbrief und die Recherche von Kunden/Lieferanten (Anthropic-API
# mit Websuche). Ohne Schlüssel funktioniert alles außer diesen beiden.
#
# Die Recherche greift nur, wenn der Geschäftsbericht keine Geschäftspartner
# nennt, und kostet je neuem Titel einen Aufruf mit Websuche. Ergebnisse liegen
# sieben Tage im Zwischenspeicher.
ANTHROPIC_API_KEY=sk-ant-...

# Recherche abschalten (dann bleiben Kunden/Lieferanten leer, wenn das Filing
# nichts hergibt), bzw. auf ein günstigeres Modell umstellen.
# EQUILUX_RESEARCH=off
# EQUILUX_RESEARCH_MODEL=claude-sonnet-5

# SEC EDGAR verlangt einen User-Agent mit ECHTER Kontaktadresse und blockt
# sonst mit 403. Trag deine eigene Adresse ein — example.de wird abgewiesen.
# Ohne diese Variable bleiben Kunden, Lieferanten und Anteilseigner leer.
# Der ältere Name SEC_USER_AGENT wird weiterhin akzeptiert.
SEC_USER="EQUILUX (deine@mail.de)"

# Optional: Datenquelle für Hebelprodukt-Konditionen (WKN/ISIN → Basispreis,
# Laufzeit, Bezugsverhältnis). Vorlage mit Platzhalter {id}.
# DERIV_DATA_URL="https://dein-feed.example/instrument/{id}?token=..."
