# EQUILUX — Umgebungsvariablen (nur serverseitig, nie im Client)
#
# ── Kursdaten ───────────────────────────────────────────────────────────────
# EMPFOHLEN: nur diesen einen Schlüssel setzen. EODHD deckt US, Xetra, London,
# Euronext, Krypto, Forex und Indizes ab — und liefert auch die
# Fundamentaldaten für die Bewertung. Schlüssel: eodhd.com
EODHD_API_KEY=dein_key

# Optional. Die App probiert die Quellen der Reihe nach:
#   EODHD → Databento → Polygon → Twelve Data → Yahoo → Stooq → Demo
# Ohne Schlüssel wird die jeweilige Stufe einfach übersprungen.
#
# Twelve Data — solide Alternative/Zweitquelle (kostenloses Kontingent).
# TWELVEDATA_API_KEY=dein_key
#
# Polygon — US-Aktien, Krypto, Forex, US-Indizes; kann Sekundenkerzen.
# POLYGON_API_KEY=dein_key
#
# Databento — institutionelle Tick-/Sekundendaten, nur US-Titel, Abrechnung
# nach Datenmenge. Datensatz optional überschreiben (Standard DBEQ.BASIC).
# DATABENTO_API_KEY=dein_key
# DATABENTO_DATASET=DBEQ.BASIC

# ── Übrige Kerne ────────────────────────────────────────────────────────────
# Für den Marktbrief-Kern (Anthropic-API mit Websuche). Ohne Schlüssel
# funktioniert alles außer dem Marktbrief.
ANTHROPIC_API_KEY=sk-ant-...

# SEC EDGAR verlangt einen User-Agent mit Kontaktadresse (Filings-Kern).
SEC_USER_AGENT="EQUILUX research (mail@example.de)"

# Optional: Datenquelle für Hebelprodukt-Konditionen (WKN/ISIN → Basispreis,
# Laufzeit, Bezugsverhältnis). Vorlage mit Platzhalter {id}.
# DERIV_DATA_URL="https://dein-feed.example/instrument/{id}?token=..."
