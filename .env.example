# EQUILUX — Umgebungsvariablen (nur serverseitig, nie im Client)

# Für den Marktbrief-Kern (Anthropic-API mit Websuche). Ohne Schlüssel
# funktioniert alles außer dem Marktbrief.
ANTHROPIC_API_KEY=sk-ant-...

# SEC EDGAR verlangt einen User-Agent mit Kontaktadresse (Filings-Kern).
SEC_USER_AGENT="EQUILUX research (mail@example.de)"

# Verlässliche Kursdaten (empfohlen fürs Deploy). Kostenloser Schlüssel bei
# twelvedata.com. Ist er gesetzt, ziehen Charts/Scan zuerst von Twelve Data
# (funktioniert auch aus Rechenzentren/Vercel), sonst Yahoo → Stooq → Demo.
# TWELVEDATA_API_KEY=dein_key

# Polygon.io — einzige Quelle mit echten SEKUNDENKERZEN (1-Sek-Zeitraum) und
# erste Wahl für US-Aktien, Krypto und Forex. Nicht-US-Börsen (XETRA, LSE …)
# deckt Polygon nicht ab; dort greifen Twelve Data / Yahoo.
# Hinweis: Intraday- und Sekundendaten brauchen einen bezahlten Polygon-Tarif.
# POLYGON_API_KEY=dein_key

# Databento — institutionelle Tick-/Sekundendaten (Schemas ohlcv-1s/1m/1h/1d).
# Höchste Datenqualität, deckt aber nur US-Titel (und CME-Futures) ab und wird
# nach Datenmenge abgerechnet. Steht der Schlüssel, ist Databento erste Wahl.
# Datensatz optional überschreiben (Standard: DBEQ.BASIC, konsolidierte US-Aktien).
# DATABENTO_API_KEY=dein_key
# DATABENTO_DATASET=DBEQ.BASIC

# Optional: Datenquelle für Hebelprodukt-Konditionen (WKN/ISIN → Basispreis,
# Laufzeit, Bezugsverhältnis …). Vorlage mit Platzhalter {id}. Ist sie gesetzt,
# füllt "Konditionen abrufen" die Derivate-Rechnung automatisch; sonst bleibt
# die Eingabe manuell. Es gibt keine freie öffentliche Quelle dafür.
# DERIV_DATA_URL="https://dein-feed.example/instrument/{id}?token=..."
